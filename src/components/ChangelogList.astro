---
interface Entry {
  version: string;
  date: string;
  tag?: '新增' | '修复' | '改进' | '变更';
  changes: string[];
}

interface Props {
  items: Entry[];
}

const { items } = Astro.props;

const tagClass: Record<string, string> = {
  新增: 'bg-brand-50 text-brand-700',
  修复: 'bg-amber-50 text-amber-700',
  改进: 'bg-emerald-50 text-emerald-700',
  变更: 'bg-neutral-100 text-neutral-700',
};
---

<div class="space-y-12">
  {
    items.map((entry) => (
      <article class="card">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="text-xl font-semibold tracking-tight">v{entry.version}</h2>
          <span class="text-sm text-neutral-500">{entry.date}</span>
          {entry.tag && (
            <span class:list={['rounded-full px-2.5 py-1 text-xs', tagClass[entry.tag] ?? tagClass['变更']]}>
              {entry.tag}
            </span>
          )}
        </div>

        <ul class="mt-5 space-y-3">
          {entry.changes.map((change) => (
            <li class="flex gap-3 text-sm leading-6 text-neutral-700">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400" />
              <span>{change}</span>
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
