---
import LangSwitch from './LangSwitch.astro';

const navItems = [
  { href: '/features', label: '功能' },
  { href: '/download', label: '下载' },
  { href: '/changelog', label: '更新日志' },
  { href: '/docs', label: '文档' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-neutral-200/80 bg-white/85 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/icon.png" alt="" class="h-8 w-8 rounded-lg" width="32" height="32" />
      <span class="text-lg font-semibold tracking-tight">GeoViewer</span>
    </a>

    <nav class="hidden items-center gap-1 sm:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-full px-3 py-2 text-sm transition-colors',
              isActive(item.href)
                ? 'bg-neutral-100 font-medium text-neutral-900'
                : 'text-neutral-600 hover:bg-neutral-50 hover:text-neutral-900',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LangSwitch />
      <a href="/download" class="btn-primary px-4 py-2 text-sm">下载</a>
    </div>
  </div>

  <!-- 移动端导航 -->
  <nav class="flex items-center gap-1 overflow-x-auto border-t border-neutral-100 px-5 py-2 sm:hidden">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'whitespace-nowrap rounded-full px-3 py-1.5 text-sm',
            isActive(item.href) ? 'bg-neutral-100 font-medium' : 'text-neutral-600',
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
