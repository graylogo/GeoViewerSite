---
interface FeatureItem {
  icon: string;
  title: string;
  desc: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: FeatureItem[];
  columns?: 2 | 3;
  tone?: 'white' | 'gray';
}

const { eyebrow, title, description, items, columns = 3, tone = 'white' } = Astro.props;

const icons: Record<string, string> = {
  map: '<path d="M9 4 3 7v13l6-3 6 3 6-3V4l-6 3-6-3Z" /><path d="M9 4v13M15 7v13" />',
  pin: '<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" />',
  shield: '<path d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3Z" /><path d="m9 12 2 2 4-4" />',
  columns: '<rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16M15 4v16" />',
  stack: '<path d="m12 3 9 5-9 5-9-5 9-5Z" /><path d="m3 13 9 5 9-5" />',
  terminal: '<rect x="3" y="4" width="18" height="16" rx="2" /><path d="m7 9 3 3-3 3M13 15h4" />',
  globe: '<circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.6 2.5 4 5.7 4 9s-1.4 6.5-4 9c-2.6-2.5-4-5.7-4-9s1.4-6.5 4-9Z" />',
  bolt: '<path d="M13 3 5 14h6l-1 7 8-11h-6l1-7Z" />',
  check: '<path d="m5 13 4 4L19 7" />',
  clock: '<circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />',
  folder: '<path d="M3 7a2 2 0 0 1 2-2h3l2 2h7a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z" />',
  scope: '<circle cx="12" cy="12" r="8" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" />',
};
---

<section class:list={['py-20', tone === 'gray' ? 'bg-neutral-50' : 'bg-white']}>
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      {eyebrow && <p class="text-sm font-medium text-brand-600">{eyebrow}</p>}
      <h2 class="mt-2 section-title">{title}</h2>
      {description && <p class="mt-4 text-base leading-7 text-neutral-600">{description}</p>}
    </div>

    <div
      class:list={[
        'mt-12 grid gap-6',
        columns === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3',
      ]}
    >
      {
        items.map((item) => (
          <div class="card">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[item.icon] ?? icons.check}
              />
            </div>
            <h3 class="mt-5 text-base font-semibold">{item.title}</h3>
            <p class="mt-2 text-sm leading-6 text-neutral-600">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
